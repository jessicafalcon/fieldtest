# Copy to `.env` (gitignored; `chmod 600 .env`) and fill in. Every key fieldtest uses
# lives here and nowhere else. Claude never reads or loads this file. Only the loop's
# driver does: `scripts/loop_auth.py` reads the App keys, and `scripts/autopilot.sh` hands
# the model key to the session masked by the sandbox (ADR 0005). Check what's set with
# `python3 scripts/preflight.py` (it never prints a value). Steps: PROJECT-BRIEF.md §12.

# The loop's GitHub App (§12, step 4), needed from Phase 0A.
FIELDTEST_APP_ID=
FIELDTEST_APP_INSTALLATION_ID=
# The App's private key as one line: `base64 -i <downloaded>.pem | tr -d '\n'`.
# Delete the .pem file afterwards.
FIELDTEST_APP_PRIVATE_KEY=

# Mistral API key (§12, step 5), needed from Phase 0B: the smoke call and recording the
# replay cache. A key made for fieldtest, with training on API data turned off.
MISTRAL_API_KEY=
