# Copy to `.env` (gitignored) and fill in. Commands that make a live call load it with
# `uv run --env-file .env ...`; nothing in fieldtest reads this file itself.

# Mistral API key for live calls: Phase 0B's smoke call, and recording the replay cache.
# Use a key made for fieldtest, with training on API data turned off in the console.
MISTRAL_API_KEY=
